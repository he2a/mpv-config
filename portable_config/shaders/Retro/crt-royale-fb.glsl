vec4 vertex_erf6(vec4 x) {
    const vec4 one = vec4(1.);
    const vec4 sign_x = sign(x);
    const vec4 t = one / (one + 0.47047 * abs(x));
    const vec4 result = one - t * (0.3480242 + t * (-0.0958798 + t * 0.7478556)) * exp(-(x * x));
    return result * sign_x;
}

