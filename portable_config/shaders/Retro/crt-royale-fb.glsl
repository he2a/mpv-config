vec3 vertex_tex2Daa_debug_dynamic(const sampler2D tex, const vec2 tex_uv, const mat2x2 pixel_to_tex_uv, const float frame) {
    const int grid_size = 8;
    vertex_assign_aa_cubic_constants();
    const vec4 ssd_fai = vertex_get_subpixel_support_diam_and_final_axis_importance();
    const vec2 subpixel_support_diameter = ssd_fai.xy;
    const vec2 final_axis_importance = ssd_fai.zw;
    const float grid_radius_in_samples = (float(grid_size) - 1.) / 2.;
    const vec2 filter_space_offset_step = subpixel_support_diameter / vec2(grid_size);
    const vec2 sample0_filter_space_offset = -grid_radius_in_samples * filter_space_offset_step;
    vec3 weights[64];
    vec3 weight_sum = vec3(0., 0., 0.);
    for (int i = 0; i < grid_size; ++i) {
        for (int j = 0; j < grid_size; ++j) {
            const vec2 offset = sample0_filter_space_offset + vec2(j, i) * filter_space_offset_step;
            const vec3 weight = vertex_eval_unorm_rgb_weights(offset, final_axis_importance);
            weights[i * grid_size + j] = weight;
            weight_sum += weight;
        }
    }
    const mat2x2 true_pixel_to_tex_uv = mat2x2(pixel_to_tex_uv * vertex_aa_pixel_diameter);
    const vec2 uv_offset_step_x = vec2(filter_space_offset_step.x, 0.) * true_pixel_to_tex_uv;
    const vec2 uv_offset_step_y = vec2(0., filter_space_offset_step.y) * true_pixel_to_tex_uv;
    const vec2 sample0_uv_offset = -grid_radius_in_samples * (uv_offset_step_x + uv_offset_step_y);
    const vec2 sample0_uv = tex_uv + sample0_uv_offset;
    vec3 sum = vec3(0., 0., 0.);
    const vec3 weight_sum_inv = vec3(1.) / weight_sum;
    for (int i = 0; i < grid_size; ++i) {
        const vec2 row_i_first_sample_uv = sample0_uv + i * uv_offset_step_y;
        for (int j = 0; j < grid_size; ++j) {
            const vec2 sample_uv = row_i_first_sample_uv + j * uv_offset_step_x;
            sum += weights[i * grid_size + j] * vertex_tex2Daa_tiled_linearize(tex, sample_uv).rgb;
        }
    }
    return sum * weight_sum_inv;
}

vec3 vertex_tex2Daa(const sampler2D tex, const vec2 tex_uv, const mat2x2 pixel_to_tex_uv, const float frame) {
    return vertex_aa_level < 0.5 ? vertex_tex2D_linearize(tex, tex_uv).rgb : vertex_aa_level < 3.5 ? vertex_tex2Daa_subpixel_weights_only(tex, tex_uv, pixel_to_tex_uv) : vertex_aa_level < 4.5 ? vertex_tex2Daa4x(tex, tex_uv, pixel_to_tex_uv, frame) : vertex_aa_level < 5.5 ? vertex_tex2Daa5x(tex, tex_uv, pixel_to_tex_uv, frame) : vertex_aa_level < 6.5 ? vertex_tex2Daa6x(tex, tex_uv, pixel_to_tex_uv, frame) : vertex_aa_level < 7.5 ? vertex_tex2Daa7x(tex, tex_uv, pixel_to_tex_uv, frame) : vertex_aa_level < 11.5 ? vertex_tex2Daa8x(tex, tex_uv, pixel_to_tex_uv, frame) : vertex_aa_level < 15.5 ? vertex_tex2Daa12x(tex, tex_uv, pixel_to_tex_uv, frame) : vertex_aa_level < 19.5 ? vertex_tex2Daa16x(tex, tex_uv, pixel_to_tex_uv, frame) : vertex_aa_level < 23.5 ? vertex_tex2Daa20x(tex, tex_uv, pixel_to_tex_uv, frame) : vertex_aa_level < 253.5 ? vertex_tex2Daa24x(tex, tex_uv, pixel_to_tex_uv, frame) : vertex_aa_level < 254.5 ? vertex_tex2Daa_debug_16x_regular(tex, tex_uv, pixel_to_tex_uv, frame) : vertex_tex2Daa_debug_dynamic(tex, tex_uv, pixel_to_tex_uv, frame);
}

vec2 vertex_quadratic_solve(const float a, const float b_over_2, const float c) {
    const float discriminant = b_over_2 * b_over_2 - a * c;
    const float solution0 = c / (-b_over_2 + sqrt(discriminant));
    return vec2(solution0, discriminant);
}

vec2 vertex_intersect_sphere(const vec3 view_vec, const vec3 eye_pos_vec) {
    const float a = dot(view_vec, view_vec);
    const float b_over_2 = dot(view_vec, eye_pos_vec);
    const float c = dot(eye_pos_vec, eye_pos_vec) - global.geom_radius * global.geom_radius;
    return vertex_quadratic_solve(a, b_over_2, c);
}

vec2 vertex_intersect_cylinder(const vec3 view_vec, const vec3 eye_pos_vec) {
    const vec3 cylinder_top_vec = vec3(0., global.geom_radius, 0.);
    const vec3 cylinder_axis_vec = vec3(0., 1., 0.);
    const vec3 top_to_eye_vec = eye_pos_vec - cylinder_top_vec;
    const vec3 axis_x_view = cross(cylinder_axis_vec, view_vec);
    const vec3 axis_x_top_to_eye = cross(cylinder_axis_vec, top_to_eye_vec);
    const float a = dot(axis_x_view, axis_x_view);
    const float b_over_2 = dot(axis_x_top_to_eye, axis_x_view);
    const float c = dot(axis_x_top_to_eye, axis_x_top_to_eye) - global.geom_radius * global.geom_radius;
    return vertex_quadratic_solve(a, b_over_2, c);
}

vec2 vertex_cylinder_xyz_to_uv(const vec3 intersection_pos_local, const vec2 geom_aspect) {
    const float angle_from_image_center = atan(intersection_pos_local.x, intersection_pos_local.z);
    const float signed_arc_len = angle_from_image_center * global.geom_radius;
    const vec2 square_uv = vec2(signed_arc_len, -intersection_pos_local.y);
    const vec2 video_uv = square_uv / geom_aspect;
    return video_uv;
}

vec3 vertex_cylinder_uv_to_xyz(const vec2 video_uv, const vec2 geom_aspect) {
    const vec2 square_uv = video_uv * geom_aspect;
    const float arc_len = square_uv.x;
    const float angle_from_image_center = arc_len / global.geom_radius;
    const float x_pos = sin(angle_from_image_center) * global.geom_radius;
    const float z_pos = cos(angle_from_image_center) * global.geom_radius;
    const vec3 intersection_pos_local = vec3(x_pos, -square_uv.y, z_pos);
    return intersection_pos_local;
}

vec2 vertex_sphere_xyz_to_uv(const vec3 intersection_pos_local, const vec2 geom_aspect) {
    const vec3 image_center_pos_local = vec3(0., 0., global.geom_radius);
    const float cp_len = length(cross(intersection_pos_local, image_center_pos_local));
    const float dp = dot(intersection_pos_local, image_center_pos_local);
    const float angle_from_image_center = atan(cp_len, dp);
    const float arc_len = angle_from_image_center * global.geom_radius;
    const vec2 square_uv_unit = normalize(vec2(intersection_pos_local.x, -intersection_pos_local.y));
    const vec2 square_uv = arc_len * square_uv_unit;
    const vec2 video_uv = square_uv / geom_aspect;
    return video_uv;
}

vec3 vertex_sphere_uv_to_xyz(const vec2 video_uv, const vec2 geom_aspect) {
    const vec2 square_uv = video_uv * geom_aspect;
    const vec2 square_uv_unit = normalize(square_uv);
    const float arc_len = square_uv.y / square_uv_unit.y;
    const float angle_from_image_center = arc_len / global.geom_radius;
    const float xy_dist_from_sphere_center = sin(angle_from_image_center) * global.geom_radius;
    const vec2 xy_pos = xy_dist_from_sphere_center * square_uv_unit;
    const float z_pos = cos(angle_from_image_center) * global.geom_radius;
    const vec3 intersection_pos_local = vec3(xy_pos.x, -xy_pos.y, z_pos);
    return intersection_pos_local;
}

vec2 vertex_sphere_alt_xyz_to_uv(const vec3 intersection_pos_local, const vec2 geom_aspect) {
    const vec2 angle_from_image_center = atan(vec2(intersection_pos_local.x, -intersection_pos_local.y), intersection_pos_local.zz);
    const vec2 signed_arc_len = angle_from_image_center * global.geom_radius;
    const vec2 video_uv = signed_arc_len / geom_aspect;
    return video_uv;
}

vec3 vertex_sphere_alt_uv_to_xyz(const vec2 video_uv, const vec2 geom_aspect) {
    const vec2 square_uv = video_uv * geom_aspect;
    const vec2 arc_len = square_uv;
    const vec2 angle_from_image_center = arc_len / global.geom_radius;
    const vec2 xy_pos = sin(angle_from_image_center) * global.geom_radius;
    const float z_pos = sqrt(global.geom_radius * global.geom_radius - dot(xy_pos, xy_pos));
    return vec3(xy_pos.x, -xy_pos.y, z_pos);
}

vec2 vertex_intersect(const vec3 view_vec_local, const vec3 eye_pos_local, const float geom_mode) {
    return geom_mode < 2.5 ? vertex_intersect_sphere(view_vec_local, eye_pos_local) : vertex_intersect_cylinder(view_vec_local, eye_pos_local);
}

vec2 vertex_xyz_to_uv(const vec3 intersection_pos_local, const vec2 geom_aspect, const float geom_mode) {
    return geom_mode < 1.5 ? vertex_sphere_xyz_to_uv(intersection_pos_local, geom_aspect) : geom_mode < 2.5 ? vertex_sphere_alt_xyz_to_uv(intersection_pos_local, geom_aspect) : vertex_cylinder_xyz_to_uv(intersection_pos_local, geom_aspect);
}

vec3 vertex_uv_to_xyz(const vec2 uv, const vec2 geom_aspect, const float geom_mode) {
    return geom_mode < 1.5 ? vertex_sphere_uv_to_xyz(uv, geom_aspect) : geom_mode < 2.5 ? vertex_sphere_alt_uv_to_xyz(uv, geom_aspect) : vertex_cylinder_uv_to_xyz(uv, geom_aspect);
}

vec2 vertex_view_vec_to_uv(const vec3 view_vec_local, const vec3 eye_pos_local, const vec2 geom_aspect, const float geom_mode, out vec3 intersection_pos) {
    const vec2 intersect_dist_and_discriminant = vertex_intersect(view_vec_local, eye_pos_local, geom_mode);
    const vec3 intersection_pos_local = eye_pos_local + view_vec_local * intersect_dist_and_discriminant.x;
    intersection_pos = intersection_pos_local;
    return intersect_dist_and_discriminant.y > 0.005 ? vertex_xyz_to_uv(intersection_pos_local, geom_aspect, geom_mode) : vec2(1.);
}

vec3 vertex_get_ideal_global_eye_pos_for_points(vec3 eye_pos, const vec2 geom_aspect, const vec3 global_coords[9], const int num_points) {
    const int max_centering_iters = 1;
    for (int iter = 0; iter < max_centering_iters; iter++) {
        vec3 eyespace_coords[9];
        for (int i = 0; i < num_points; i++) {
            eyespace_coords[i] = global_coords[i] - eye_pos;
        }
        float abs_radius = abs(global.geom_radius);
        vec2 offset_dr_min = vec2(10. * abs_radius, 10. * abs_radius);
        vec2 offset_ul_max = vec2(-10. * abs_radius, -10. * abs_radius);
        for (int i = 0; i < num_points; i++) {
            const vec2 flipy = vec2(1., -1.);
            vec3 eyespace_xyz = eyespace_coords[i];
            vec2 offset_dr = eyespace_xyz.xy - vec2(-0.5) * (geom_aspect * -eyespace_xyz.z) / (global.geom_view_dist * flipy);
            vec2 offset_ul = eyespace_xyz.xy - vec2(0.5) * (geom_aspect * -eyespace_xyz.z) / (global.geom_view_dist * flipy);
            offset_dr_min = min(offset_dr_min, offset_dr);
            offset_ul_max = max(offset_ul_max, offset_ul);
        }
        vec2 center_offset = 0.5 * (offset_ul_max + offset_dr_min);
        eye_pos.xy += center_offset;
        for (int i = 0; i < num_points; i++) {
            eyespace_coords[i] = global_coords[i] - eye_pos;
        }
        float offset_z_max = -10. * global.geom_radius * global.geom_view_dist;
        for (int i = 0; i < num_points; i++) {
            vec3 eyespace_xyz_flipy = eyespace_coords[i] * vec3(1., -1., 1.);
            vec4 offset_zzzz = eyespace_xyz_flipy.zzzz + eyespace_xyz_flipy.xyxy * global.geom_view_dist / (vec4(-0.5, -0.5, 0.5, 0.5) * vec4(geom_aspect, geom_aspect));
            offset_z_max = eyespace_xyz_flipy.x < 0. ? max(offset_z_max, offset_zzzz.x) : offset_z_max;
            offset_z_max = eyespace_xyz_flipy.y < 0. ? max(offset_z_max, offset_zzzz.y) : offset_z_max;
            offset_z_max = eyespace_xyz_flipy.x > 0. ? max(offset_z_max, offset_zzzz.z) : offset_z_max;
            offset_z_max = eyespace_xyz_flipy.y > 0. ? max(offset_z_max, offset_zzzz.w) : offset_z_max;
            offset_z_max = max(offset_z_max, eyespace_xyz_flipy.z);
        }
        eye_pos.z += offset_z_max;
    }
    return eye_pos;
}

vec3 vertex_get_ideal_global_eye_pos(const mat3x3 local_to_global, const vec2 geom_aspect, const float geom_mode) {
    const vec3 high_view = vec3(0., geom_aspect.y, -global.geom_view_dist);
    const vec3 low_view = high_view * vec3(1., -1., 1.);
    const float len_sq = dot(high_view, high_view);
    const float fov = abs(acos(dot(high_view, low_view) / len_sq));
    const float eye_z_spherical = global.geom_radius / sin(fov * 0.5);
    const vec3 eye_pos = geom_mode < 2.5 ? vec3(0., 0., eye_z_spherical) : vec3(0., 0., max(global.geom_view_dist, eye_z_spherical));
    const int num_points = 9;
    vec3 global_coords[9];
    global_coords[0] = vertex_uv_to_xyz(vec2(0., 0.), geom_aspect, geom_mode) * local_to_global;
    global_coords[1] = vertex_uv_to_xyz(vec2(0., -0.5), geom_aspect, geom_mode) * local_to_global;
    global_coords[2] = vertex_uv_to_xyz(vec2(0., 0.5), geom_aspect, geom_mode) * local_to_global;
    global_coords[3] = vertex_uv_to_xyz(vec2(-0.5, 0.), geom_aspect, geom_mode) * local_to_global;
    global_coords[4] = vertex_uv_to_xyz(vec2(0.5, 0.), geom_aspect, geom_mode) * local_to_global;
    global_coords[5] = vertex_uv_to_xyz(vec2(-0.5, -0.5), geom_aspect, geom_mode) * local_to_global;
    global_coords[6] = vertex_uv_to_xyz(vec2(0.5, -0.5), geom_aspect, geom_mode) * local_to_global;
    global_coords[7] = vertex_uv_to_xyz(vec2(-0.5, 0.5), geom_aspect, geom_mode) * local_to_global;
    global_coords[8] = vertex_uv_to_xyz(vec2(0.5, 0.5), geom_aspect, geom_mode) * local_to_global;
    float num_negative_z_coords = 0.;
    for (int i = 0; i < num_points; i++) {
        num_negative_z_coords += float(global_coords[0].z < 0.);
    }
    return num_negative_z_coords > 0.5 ? eye_pos : vertex_get_ideal_global_eye_pos_for_points(eye_pos, geom_aspect, global_coords, num_points);
}

mat3x3 vertex_get_pixel_to_object_matrix(const mat3x3 global_to_local, const vec3 eye_pos_local, const vec3 view_vec_global, const vec3 intersection_pos_local, const vec3 normal, const vec2 output_size_inv) {
    const vec3 pos = intersection_pos_local;
    const vec3 eye_pos = eye_pos_local;
    const vec3 view_vec_right_global = view_vec_global + vec3(output_size_inv.x, 0., 0.);
    const vec3 view_vec_down_global = view_vec_global + vec3(0., -output_size_inv.y, 0.);
    const vec3 view_vec_right_local = view_vec_right_global * global_to_local;
    const vec3 view_vec_down_local = view_vec_down_global * global_to_local;
    const vec3 intersection_vec_dot_normal = vec3(dot(pos - eye_pos, normal), dot(pos - eye_pos, normal), dot(pos - eye_pos, normal));
    const vec3 right_pos = eye_pos + intersection_vec_dot_normal / dot(view_vec_right_local, normal) * view_vec_right_local;
    const vec3 down_pos = eye_pos + intersection_vec_dot_normal / dot(view_vec_down_local, normal) * view_vec_down_local;
    const vec3 object_right_vec = right_pos - pos;
    const vec3 object_down_vec = down_pos - pos;
    const mat3x3 pixel_to_object = mat3x3(object_right_vec.x, object_down_vec.x, 0., object_right_vec.y, object_down_vec.y, 0., object_right_vec.z, object_down_vec.z, 0.);
    return pixel_to_object;
}

mat3x3 vertex_get_object_to_tangent_matrix(const vec3 intersection_pos_local, const vec3 normal, const vec2 geom_aspect, const float geom_mode) {
    const vec3 pos = intersection_pos_local;
    const vec3 x_vec = vec3(1., 0., 0.);
    const vec3 y_vec = vec3(0., 1., 0.);
    vec3 cotangent_unscaled, cobitangent_unscaled;
    if (geom_mode < 1.5) {
        cotangent_unscaled = normalize(cross(y_vec, pos)) * geom_aspect.y;
        cobitangent_unscaled = normalize(cross(x_vec, pos)) * geom_aspect.x;
    } else if (geom_mode < 2.5) {
        const vec3 tangent = normalize(cross(y_vec, vec3(pos.x, 0., pos.z))) * geom_aspect.x;
        const vec3 bitangent = normalize(cross(x_vec, vec3(0., pos.yz))) * geom_aspect.y;
        cotangent_unscaled = cross(normal, bitangent);
        cobitangent_unscaled = cross(tangent, normal);
    } else {
        cotangent_unscaled = cross(y_vec, normal) * geom_aspect.y;
        cobitangent_unscaled = vec3(0., -geom_aspect.x, 0.);
    }
    const vec3 computed_normal = cross(cobitangent_unscaled, cotangent_unscaled);
    const float inv_determinant = inversesqrt(dot(computed_normal, computed_normal));
    const vec3 cotangent = cotangent_unscaled * inv_determinant;
    const vec3 cobitangent = cobitangent_unscaled * inv_determinant;
    const mat3x3 object_to_tangent = mat3x3(cotangent, cobitangent, normal);
    return object_to_tangent;
}

vec2 vertex_get_curved_video_uv_coords_and_tangent_matrix(const vec2 flat_video_uv, const vec3 eye_pos_local, const vec2 output_size_inv, const vec2 geom_aspect, const float geom_mode, const mat3x3 global_to_local, out mat2x2 pixel_to_tangent_video_uv) {
    const vec2 view_uv = (flat_video_uv - vec2(0.5)) * geom_aspect;
    const vec3 view_vec_global = vec3(view_uv.x, -view_uv.y, -global.geom_view_dist);
    const vec3 view_vec_local = view_vec_global * global_to_local;
    vec3 pos;
    const vec2 centered_uv = vertex_view_vec_to_uv(view_vec_local, eye_pos_local, geom_aspect, geom_mode, pos);
    const vec2 video_uv = centered_uv + vec2(0.5);
    if (vertex_geom_force_correct_tangent_matrix) {
        const vec3 normal_base = geom_mode < 2.5 ? pos : vec3(pos.x, 0., pos.z);
        const vec3 normal = normalize(normal_base);
        const mat3x3 pixel_to_object = vertex_get_pixel_to_object_matrix(global_to_local, eye_pos_local, view_vec_global, pos, normal, output_size_inv);
        const mat3x3 object_to_tangent = vertex_get_object_to_tangent_matrix(pos, normal, geom_aspect, geom_mode);
        const mat3x3 pixel_to_tangent3x3 = pixel_to_object * object_to_tangent;
        pixel_to_tangent_video_uv = mat2x2(pixel_to_tangent3x3[0][0], pixel_to_tangent3x3[0][1], pixel_to_tangent3x3[1][0], pixel_to_tangent3x3[1][1]);
    } else {
        pixel_to_tangent_video_uv = mat2x2(output_size_inv.x, 0., 0., output_size_inv.y);
    }
    return video_uv;
}

float vertex_get_border_dim_factor(const vec2 video_uv, const vec2 geom_aspect) {
    const vec2 edge_dists = min(video_uv, vec2(1.) - video_uv) * geom_aspect;
    const vec2 border_penetration = max(vec2(global.border_size) - edge_dists, vec2(0.));
    float penetration_ratio = length(border_penetration) / global.border_size;
    if (global.border_size == 0.) penetration_ratio = 0.;
    const float border_escape_ratio = max(1. - penetration_ratio, 0.);
    const float border_dim_factor = pow(border_escape_ratio, global.border_darkness) * max(1., global.border_compress);
    return min(border_dim_factor, 1.);
}

mat2x2 vertex_mul_scale(vec2 scale, mat2x2 matrix) {
    vec4 temp_matrix = vec4(matrix[0][0], matrix[0][1], matrix[1][0], matrix[1][1]) * scale.xxyy;
    return mat2x2(temp_matrix.x, temp_matrix.y, temp_matrix.z, temp_matrix.w);
}

vec4 Position = vec4(HOOKED_pos, 0., 1.);
vec2 TexCoord = HOOKED_pos;
vec2 tex_uv;
vec4 video_and_texture_size_inv;
vec2 output_size_inv;
vec3 eye_pos_local;
vec4 geom_aspect_and_overscan;
vec3 global_to_local_row0;
vec3 global_to_local_row1;
vec3 global_to_local_row2;
void vertex_main() {
    vertex_gl_Position = global.MVP * Position;
    tex_uv = TexCoord;
    video_and_texture_size_inv = vec4(1., 1., 1., 1.) / vec4(params.SourceSize.xy, params.SourceSize.xy);
    output_size_inv = vec2(1., 1.) / params.OutputSize.xy;
    const float viewport_aspect_ratio = params.OutputSize.xy.x / params.OutputSize.xy.y;
    const vec2 geom_aspect = vertex_get_aspect_vector(viewport_aspect_ratio);
    const vec2 geom_overscan = vertex_get_geom_overscan_vector();
    geom_aspect_and_overscan = vec4(geom_aspect, geom_overscan);
    const vec2 geom_tilt_angle = vertex_get_geom_tilt_angle_vector();
    const vec2 sin_tilt = sin(geom_tilt_angle);
    const vec2 cos_tilt = cos(geom_tilt_angle);
    const mat3x3 rot_x_matrix = mat3x3(1., 0., 0., 0., cos_tilt.y, -sin_tilt.y, 0., sin_tilt.y, cos_tilt.y);
    const mat3x3 rot_y_matrix = mat3x3(cos_tilt.x, 0., sin_tilt.x, 0., 1., 0., -sin_tilt.x, 0., cos_tilt.x);
    const mat3x3 local_to_global = rot_x_matrix * rot_y_matrix;
    const mat3x3 global_to_local = transpose(local_to_global);
    global_to_local_row0 = vec3(global_to_local[0][0], global_to_local[0][1], global_to_local[0][2]);
    global_to_local_row1 = vec3(global_to_local[1][0], global_to_local[1][1], global_to_local[1][2]);
    global_to_local_row2 = vec3(global_to_local[2][0], global_to_local[2][1], global_to_local[2][2]);
    const float geom_mode = vertex_geom_mode_static;
    const vec3 eye_pos_global = vertex_get_ideal_global_eye_pos(local_to_global, geom_aspect, geom_mode);
    eye_pos_local = eye_pos_global * global_to_local;
}

const float fragment_crt_gamma_static = 2.5;
const float fragment_lcd_gamma_static = 2.2;
const float fragment_levels_contrast_static = 1.;
const float fragment_levels_autodim_temp = 0.5;
const float fragment_halation_weight_static = 0.;
const float fragment_diffusion_weight_static = 0.075;
const float fragment_bloom_underestimate_levels_static = 0.8;
const float fragment_bloom_excess_static = 0.;
