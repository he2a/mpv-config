vec4 fragment_quad_gather(const vec4 quad_vector, const float curr) {
    vec4 all = vec4(curr);
    all.y = all.x - dFdx(all.x) * quad_vector.z;
    all.zw = all.xy - dFdy(all.xy) * quad_vector.w;
    return all;
}

