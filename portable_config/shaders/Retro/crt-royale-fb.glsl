    const float w1off = exp(-(1. * 1.) * denom_inv);
    const float w1_5off = exp(-(1.5 * 1.5) * denom_inv);
    const float w2off = exp(-(2. * 2.) * denom_inv);
    const float w2_5off = exp(-(2.5 * 2.5) * denom_inv);
    const float w3_5off = exp(-(3.5 * 3.5) * denom_inv);
    const float texel0to1ratio = mix(w1_5off / (w0_5off + w1_5off), 0.5, fragment_error_blurring);
    const float texel2to3ratio = mix(w3_5off / (w2_5off + w3_5off), 0.5, fragment_error_blurring);
    const float texel0to1ratio_nearest = w1off / (w0off + w1off);
    const float texel1to2ratio_nearest = w2off / (w1off + w2off);
    const vec2 sample0curr_texel_offset = vec2(0., 0.) + vec2(texel0to1ratio_nearest, texel0to1ratio_nearest);
    const vec2 sample0adjx_texel_offset = vec2(-1., 0.) + vec2(-texel1to2ratio_nearest, texel0to1ratio_nearest);
    const vec2 sample0adjy_texel_offset = vec2(0., -1.) + vec2(texel0to1ratio_nearest, -texel1to2ratio_nearest);
    const vec2 sample0diag_texel_offset = vec2(-1., -1.) + vec2(-texel1to2ratio_nearest, -texel1to2ratio_nearest);
    const vec2 sample1_texel_offset = vec2(2., 0.) + vec2(texel2to3ratio, texel0to1ratio);
    const vec2 sample2_texel_offset = vec2(0., 2.) + vec2(texel0to1ratio, texel2to3ratio);
    const vec2 sample3_texel_offset = vec2(2., 2.) + vec2(texel2to3ratio, texel2to3ratio);
    const float w0diag = exp(-dot(vec2(-2., -2.), vec2(-2., -2.)) * denom_inv) + exp(-dot(vec2(-2. + 1., -2.), vec2(-2. + 1., -2.)) * denom_inv) + exp(-dot(vec2(-2., -2. + 1.), vec2(-2., -2. + 1.)) * denom_inv) + exp(-dot(vec2(-2. + 1., -2. + 1.), vec2(-2. + 1., -2. + 1.)) * denom_inv);
