vec3 fragment_tex2Dblur11resize(const sampler2D tex, const vec2 tex_uv, const vec2 dxdy, const float sigma) {
    const float denom_inv = 0.5 / (sigma * sigma);
    const float w0 = 1.;
    const float w1 = exp(-1. * denom_inv);
    const float w2 = exp(-4. * denom_inv);
    const float w3 = exp(-9. * denom_inv);
    const float w4 = exp(-16. * denom_inv);
    const float w5 = exp(-25. * denom_inv);
    const float weight_sum_inv = 1. / (w0 + 2. * (w1 + w2 + w3 + w4 + w5));
    vec3 sum = vec3(0., 0., 0.);
    sum += w5 * fragment_tex2D_linearize(tex, tex_uv - 5. * dxdy).rgb;
    sum += w4 * fragment_tex2D_linearize(tex, tex_uv - 4. * dxdy).rgb;
    sum += w3 * fragment_tex2D_linearize(tex, tex_uv - 3. * dxdy).rgb;
    sum += w2 * fragment_tex2D_linearize(tex, tex_uv - 2. * dxdy).rgb;
    sum += w1 * fragment_tex2D_linearize(tex, tex_uv - 1. * dxdy).rgb;
    sum += w0 * fragment_tex2D_linearize(tex, tex_uv).rgb;
    sum += w1 * fragment_tex2D_linearize(tex, tex_uv + 1. * dxdy).rgb;
    sum += w2 * fragment_tex2D_linearize(tex, tex_uv + 2. * dxdy).rgb;
    sum += w3 * fragment_tex2D_linearize(tex, tex_uv + 3. * dxdy).rgb;
    sum += w4 * fragment_tex2D_linearize(tex, tex_uv + 4. * dxdy).rgb;
    sum += w5 * fragment_tex2D_linearize(tex, tex_uv + 5. * dxdy).rgb;
    return sum * weight_sum_inv;
}

