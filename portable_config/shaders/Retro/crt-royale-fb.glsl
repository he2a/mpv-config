vec4 fragment_ligamma_small_z_impl(const vec4 s, const vec4 z, const vec4 s_inv) {
    const vec4 scale = pow(z, s);
    vec4 sum = s_inv;
    const vec4 z_sq = z * z;
    const vec4 denom1 = s + vec4(1.);
    const vec4 denom2 = 2. * s + vec4(4.);
    const vec4 denom3 = 6. * s + vec4(18.);
    sum -= z / denom1;
    sum += z_sq / denom2;
    sum -= z * z_sq / denom3;
    return scale * sum;
}

