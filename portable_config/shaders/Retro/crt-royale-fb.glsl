vec2 vertex_get_first_texel_tile_uv_and_dist(const vec2 tex_uv, const vec2 tex_size, const float dr, const float input_tiles_per_texture_r, const float samples, const bool vertical) {
    const vec2 curr_texel = tex_uv * tex_size;
    const vec2 prev_texel = floor(curr_texel - vec2(vertex_under_half)) + vec2(0.5);
    const vec2 first_texel = prev_texel - vec2(samples / 2. - 1.);
    const vec2 first_texel_uv_wrap_2D = first_texel * dr;
    const vec2 first_texel_dist_2D = curr_texel - first_texel;
    const vec2 first_texel_tile_uv_wrap_2D = first_texel_uv_wrap_2D * input_tiles_per_texture_r;
    const vec2 coord_negative = vec2(first_texel_tile_uv_wrap_2D.x < 0., first_texel_tile_uv_wrap_2D.y < 0.);
    const vec2 first_texel_tile_uv_2D = fract(first_texel_tile_uv_wrap_2D) + coord_negative;
    const vec2 tile_u_and_dist = vec2(first_texel_tile_uv_2D.x, first_texel_dist_2D.x);
    const vec2 tile_v_and_dist = vec2(first_texel_tile_uv_2D.y, first_texel_dist_2D.y);
