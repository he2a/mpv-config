vec4 fragment_get_quad_vector_naive(const vec4 output_pixel_num_wrt_uvxy) {
    const vec4 pixel_odd = fract(output_pixel_num_wrt_uvxy * 0.5) * 2.;
    const vec4 quad_vector = pixel_odd * 2. - vec4(1.);
    return quad_vector;
}

vec4 fragment_get_quad_vector(const vec4 output_pixel_num_wrt_uvxy) {
    const vec4 quad_vector_guess = fragment_get_quad_vector_naive(output_pixel_num_wrt_uvxy);
    const vec2 odd_start_mirror = 0.5 * vec2(dFdx(quad_vector_guess.z), dFdy(quad_vector_guess.w));
    return quad_vector_guess * odd_start_mirror.xyxy;
}

vec4 fragment_get_quad_vector(const vec2 output_pixel_num_wrt_uv) {
    const vec2 screen_uv_mirror = vec2(dFdx(output_pixel_num_wrt_uv.x), dFdy(output_pixel_num_wrt_uv.y));
    const vec2 pixel_odd_wrt_uv = fract(output_pixel_num_wrt_uv * 0.5) * 2.;
    const vec2 quad_vector_uv_guess = (pixel_odd_wrt_uv - vec2(0.5)) * 2.;
    const vec2 quad_vector_screen_guess = quad_vector_uv_guess * screen_uv_mirror;
    const vec2 odd_start_mirror = 0.5 * vec2(dFdx(quad_vector_screen_guess.x), dFdy(quad_vector_screen_guess.y));
    const vec4 quad_vector_guess = vec4(quad_vector_uv_guess, quad_vector_screen_guess);
    return quad_vector_guess * odd_start_mirror.xyxy;
}

void fragment_quad_gather(const vec4 quad_vector, const vec4 curr, out vec4 adjx, out vec4 adjy, out vec4 diag) {
    adjx = curr - dFdx(curr) * quad_vector.z;
    adjy = curr - dFdy(curr) * quad_vector.w;
    diag = adjx - dFdy(adjx) * quad_vector.w;
}

void fragment_quad_gather(const vec4 quad_vector, const vec3 curr, out vec3 adjx, out vec3 adjy, out vec3 diag) {
