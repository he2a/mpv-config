vec3 fragment_get_gaussian_sigma(const vec3 color, const float sigma_range) {
    if (fragment_beam_spot_shape_function < 0.5) {
        return vec3(global.beam_min_sigma) + sigma_range * pow(color, vec3(global.beam_spot_power));
    } else {
        const vec3 color_minus_1 = color - vec3(1.);
        return vec3(global.beam_min_sigma) + sigma_range * sqrt(vec3(1.) - color_minus_1 * color_minus_1);
    }
}

vec3 fragment_get_generalized_gaussian_beta(const vec3 color, const float shape_range) {
    return global.beam_min_shape + shape_range * pow(color, vec3(global.beam_shape_power));
}

vec3 fragment_scanline_gaussian_integral_contrib(const vec3 dist, const vec3 color, const float pixel_height, const float sigma_range) {
    const vec3 sigma = fragment_get_gaussian_sigma(color, sigma_range);
    const vec3 ph_offset = vec3(pixel_height * 0.5);
    const vec3 denom_inv = 1. / (sigma * sqrt(2.));
    const vec3 integral_high = fragment_erf((dist + ph_offset) * denom_inv);
    const vec3 integral_low = fragment_erf((dist - ph_offset) * denom_inv);
    return color * 0.5 * (integral_high - integral_low) / pixel_height;
}

vec3 fragment_scanline_generalized_gaussian_integral_contrib(vec3 dist, vec3 color, float pixel_height, float sigma_range, float shape_range) {
    const vec3 alpha = sqrt(2.) * fragment_get_gaussian_sigma(color, sigma_range);
    const vec3 beta = fragment_get_generalized_gaussian_beta(color, shape_range);
    const vec3 alpha_inv = vec3(1.) / alpha;
    const vec3 s = vec3(1.) / beta;
    const vec3 ph_offset = vec3(pixel_height * 0.5);
    const vec3 gamma_s_inv = vec3(1.) / fragment_gamma_impl(s, beta);
    const vec3 dist1 = dist + ph_offset;
    const vec3 dist0 = dist - ph_offset;
    const vec3 integral_high = sign(dist1) * fragment_normalized_ligamma_impl(s, pow(abs(dist1) * alpha_inv, beta), beta, gamma_s_inv);
    const vec3 integral_low = sign(dist0) * fragment_normalized_ligamma_impl(s, pow(abs(dist0) * alpha_inv, beta), beta, gamma_s_inv);
    return color * 0.5 * (integral_high - integral_low) / pixel_height;
}

vec3 fragment_scanline_gaussian_sampled_contrib(const vec3 dist, const vec3 color, const float pixel_height, const float sigma_range) {
    const vec3 sigma = fragment_get_gaussian_sigma(color, sigma_range);
    const vec3 sigma_inv = vec3(1.) / sigma;
    const vec3 inner_denom_inv = 0.5 * sigma_inv * sigma_inv;
    const vec3 outer_denom_inv = sigma_inv / sqrt(2. * fragment_pi);
    if (fragment_beam_antialias_level > 0.5) {
        const vec3 sample_offset = vec3(pixel_height / 3.);
        const vec3 dist2 = dist + sample_offset;
        const vec3 dist3 = abs(dist - sample_offset);
        const vec3 scale = color / 3. * outer_denom_inv;
        const vec3 weight1 = exp(-(dist * dist) * inner_denom_inv);
        const vec3 weight2 = exp(-(dist2 * dist2) * inner_denom_inv);
        const vec3 weight3 = exp(-(dist3 * dist3) * inner_denom_inv);
        return scale * (weight1 + weight2 + weight3);
    } else {
        return color * exp(-(dist * dist) * inner_denom_inv) * outer_denom_inv;
    }
}

vec3 fragment_scanline_generalized_gaussian_sampled_contrib(vec3 dist, vec3 color, float pixel_height, float sigma_range, float shape_range) {
    const vec3 alpha = sqrt(2.) * fragment_get_gaussian_sigma(color, sigma_range);
    const vec3 beta = fragment_get_generalized_gaussian_beta(color, shape_range);
    const vec3 alpha_inv = vec3(1.) / alpha;
    const vec3 beta_inv = vec3(1.) / beta;
    const vec3 scale = color * beta * 0.5 * alpha_inv / fragment_gamma_impl(beta_inv, beta);
    if (fragment_beam_antialias_level > 0.5) {
        const vec3 sample_offset = vec3(pixel_height / 3.);
        const vec3 dist2 = dist + sample_offset;
        const vec3 dist3 = abs(dist - sample_offset);
        const vec3 weight1 = exp(-pow(abs(dist * alpha_inv), beta));
        const vec3 weight2 = exp(-pow(abs(dist2 * alpha_inv), beta));
        const vec3 weight3 = exp(-pow(abs(dist3 * alpha_inv), beta));
        return scale / 3. * (weight1 + weight2 + weight3);
    } else {
        return scale * exp(-pow(abs(dist * alpha_inv), beta));
    }
}

vec3 fragment_scanline_contrib(vec3 dist, vec3 color, float pixel_height, const float sigma_range, const float shape_range) {
    if (fragment_beam_generalized_gaussian) {
        if (fragment_beam_antialias_level > 1.5) {
