    const float w2adjy = exp(-dot(vec2(0., -4.), vec2(0., -4.)) * denom_inv) + exp(-dot(vec2(0. + 1., -4.), vec2(0. + 1., -4.)) * denom_inv) + exp(-dot(vec2(0., -4. + 1.), vec2(0., -4. + 1.)) * denom_inv) + exp(-dot(vec2(0. + 1., -4. + 1.), vec2(0. + 1., -4. + 1.)) * denom_inv);
    const float w3adjy = exp(-dot(vec2(2., -4.), vec2(2., -4.)) * denom_inv) + exp(-dot(vec2(2. + 1., -4.), vec2(2. + 1., -4.)) * denom_inv) + exp(-dot(vec2(2., -4. + 1.), vec2(2., -4. + 1.)) * denom_inv) + exp(-dot(vec2(2. + 1., -4. + 1.), vec2(2. + 1., -4. + 1.)) * denom_inv);
    const float w1diag = exp(-dot(vec2(-4., -2.), vec2(-4., -2.)) * denom_inv) + exp(-dot(vec2(-4. + 1., -2.), vec2(-4. + 1., -2.)) * denom_inv) + exp(-dot(vec2(-4., -2. + 1.), vec2(-4., -2. + 1.)) * denom_inv) + exp(-dot(vec2(-4. + 1., -2. + 1.), vec2(-4. + 1., -2. + 1.)) * denom_inv);
    const float w0diag = exp(-dot(vec2(-2., -2.), vec2(-2., -2.)) * denom_inv) + exp(-dot(vec2(-2. + 1., -2.), vec2(-2. + 1., -2.)) * denom_inv) + exp(-dot(vec2(-2., -2. + 1.), vec2(-2., -2. + 1.)) * denom_inv) + exp(-dot(vec2(-2. + 1., -2. + 1.), vec2(-2. + 1., -2. + 1.)) * denom_inv);
    const float w0adjy = exp(-dot(vec2(0., -2.), vec2(0., -2.)) * denom_inv) + exp(-dot(vec2(0. + 1., -2.), vec2(0. + 1., -2.)) * denom_inv) + exp(-dot(vec2(0., -2. + 1.), vec2(0., -2. + 1.)) * denom_inv) + exp(-dot(vec2(0. + 1., -2. + 1.), vec2(0. + 1., -2. + 1.)) * denom_inv);
    const float w1adjy = exp(-dot(vec2(2., -2.), vec2(2., -2.)) * denom_inv) + exp(-dot(vec2(2. + 1., -2.), vec2(2. + 1., -2.)) * denom_inv) + exp(-dot(vec2(2., -2. + 1.), vec2(2., -2. + 1.)) * denom_inv) + exp(-dot(vec2(2. + 1., -2. + 1.), vec2(2. + 1., -2. + 1.)) * denom_inv);
    const float w1adjx = exp(-dot(vec2(-4., 0.), vec2(-4., 0.)) * denom_inv) + exp(-dot(vec2(-4. + 1., 0.), vec2(-4. + 1., 0.)) * denom_inv) + exp(-dot(vec2(-4., 0. + 1.), vec2(-4., 0. + 1.)) * denom_inv) + exp(-dot(vec2(-4. + 1., 0. + 1.), vec2(-4. + 1., 0. + 1.)) * denom_inv);
    const float w0adjx = exp(-dot(vec2(-2., 0.), vec2(-2., 0.)) * denom_inv) + exp(-dot(vec2(-2. + 1., 0.), vec2(-2. + 1., 0.)) * denom_inv) + exp(-dot(vec2(-2., 0. + 1.), vec2(-2., 0. + 1.)) * denom_inv) + exp(-dot(vec2(-2. + 1., 0. + 1.), vec2(-2. + 1., 0. + 1.)) * denom_inv);
    const float w0curr = exp(-dot(vec2(0., 0.), vec2(0., 0.)) * denom_inv) + exp(-dot(vec2(0. + 1., 0.), vec2(0. + 1., 0.)) * denom_inv) + exp(-dot(vec2(0., 0. + 1.), vec2(0., 0. + 1.)) * denom_inv) + exp(-dot(vec2(0. + 1., 0. + 1.), vec2(0. + 1., 0. + 1.)) * denom_inv);
    const float w1curr = exp(-dot(vec2(2., 0.), vec2(2., 0.)) * denom_inv) + exp(-dot(vec2(2. + 1., 0.), vec2(2. + 1., 0.)) * denom_inv) + exp(-dot(vec2(2., 0. + 1.), vec2(2., 0. + 1.)) * denom_inv) + exp(-dot(vec2(2. + 1., 0. + 1.), vec2(2. + 1., 0. + 1.)) * denom_inv);
    const float w3adjx = exp(-dot(vec2(-4., 2.), vec2(-4., 2.)) * denom_inv) + exp(-dot(vec2(-4. + 1., 2.), vec2(-4. + 1., 2.)) * denom_inv) + exp(-dot(vec2(-4., 2. + 1.), vec2(-4., 2. + 1.)) * denom_inv) + exp(-dot(vec2(-4. + 1., 2. + 1.), vec2(-4. + 1., 2. + 1.)) * denom_inv);
    const float w2adjx = exp(-dot(vec2(-2., 2.), vec2(-2., 2.)) * denom_inv) + exp(-dot(vec2(-2. + 1., 2.), vec2(-2. + 1., 2.)) * denom_inv) + exp(-dot(vec2(-2., 2. + 1.), vec2(-2., 2. + 1.)) * denom_inv) + exp(-dot(vec2(-2. + 1., 2. + 1.), vec2(-2. + 1., 2. + 1.)) * denom_inv);
    const float w2curr = exp(-dot(vec2(0., 2.), vec2(0., 2.)) * denom_inv) + exp(-dot(vec2(0. + 1., 2.), vec2(0. + 1., 2.)) * denom_inv) + exp(-dot(vec2(0., 2. + 1.), vec2(0., 2. + 1.)) * denom_inv) + exp(-dot(vec2(0. + 1., 2. + 1.), vec2(0. + 1., 2. + 1.)) * denom_inv);
    const float w3curr = exp(-dot(vec2(2., 2.), vec2(2., 2.)) * denom_inv) + exp(-dot(vec2(2. + 1., 2.), vec2(2. + 1., 2.)) * denom_inv) + exp(-dot(vec2(2., 2. + 1.), vec2(2., 2. + 1.)) * denom_inv) + exp(-dot(vec2(2. + 1., 2. + 1.), vec2(2. + 1., 2. + 1.)) * denom_inv);
    const vec4 w0 = vec4(w0curr, w0adjx, w0adjy, w0diag);
    const vec4 w1 = vec4(w1curr, w1adjx, w1adjy, w1diag);
    const vec4 w2 = vec4(w2curr, w2adjx, w2adjy, w2diag);
    const vec4 w3 = vec4(w3curr, w3adjx, w3adjy, w3diag);
    const vec4 weight_sum4 = w0 + w1 + w2 + w3;
    const vec2 weight_sum2 = weight_sum4.xy + weight_sum4.zw;
    const float weight_sum = weight_sum2.x + weight_sum2.y;
    const float weight_sum_inv = 1. / weight_sum;
    const vec2 dxdy_curr = dxdy * quad_vector.xy;
    const vec3 sample0curr = fragment_tex2D_linearize(tex, tex_uv.xy + dxdy_curr * sample0curr_texel_offset).rgb;
    const vec3 sample0adjx = fragment_tex2D_linearize(tex, tex_uv.xy + dxdy_curr * sample0adjx_texel_offset).rgb;
    const vec3 sample0adjy = fragment_tex2D_linearize(tex, tex_uv.xy + dxdy_curr * sample0adjy_texel_offset).rgb;
    const vec3 sample0diag = fragment_tex2D_linearize(tex, tex_uv.xy + dxdy_curr * sample0diag_texel_offset).rgb;
    const vec3 sample1curr = fragment_tex2Dlod_linearize(tex, tex_uv + fragment_uv2_to_uv4(dxdy_curr * sample1_texel_offset)).rgb;
    const vec3 sample2curr = fragment_tex2Dlod_linearize(tex, tex_uv + fragment_uv2_to_uv4(dxdy_curr * sample2_texel_offset)).rgb;
    const vec3 sample3curr = fragment_tex2Dlod_linearize(tex, tex_uv + fragment_uv2_to_uv4(dxdy_curr * sample3_texel_offset)).rgb;
    vec3 sample1adjx, sample1adjy, sample1diag;
    vec3 sample2adjx, sample2adjy, sample2diag;
    vec3 sample3adjx, sample3adjy, sample3diag;
    fragment_quad_gather(quad_vector, sample1curr, sample1adjx, sample1adjy, sample1diag);
    fragment_quad_gather(quad_vector, sample2curr, sample2adjx, sample2adjy, sample2diag);
    fragment_quad_gather(quad_vector, sample3curr, sample3adjx, sample3adjy, sample3diag);
    vec3 sum = vec3(0., 0., 0.);
    sum += mat4x3(sample0curr, sample0adjx, sample0adjy, sample0diag) * w0;
    sum += mat4x3(sample1curr, sample1adjx, sample1adjy, sample1diag) * w1;
    sum += mat4x3(sample2curr, sample2adjx, sample2adjy, sample2diag) * w2;
    sum += mat4x3(sample3curr, sample3adjx, sample3adjy, sample3diag) * w3;
    return sum * weight_sum_inv;
}

vec3 fragment_tex2Dblur6x6shared(const sampler2D tex, const vec4 tex_uv, const vec2 dxdy, const vec4 quad_vector, const float sigma) {
    const float denom_inv = 0.5 / (sigma * sigma);
    const float w0off = 1.;
    const float w0_5off = exp(-(0.5 * 0.5) * denom_inv);
    const float w1off = exp(-(1. * 1.) * denom_inv);
    const float w1_5off = exp(-(1.5 * 1.5) * denom_inv);
    const float w2off = exp(-(2. * 2.) * denom_inv);
    const float w2_5off = exp(-(2.5 * 2.5) * denom_inv);
    const float w3_5off = exp(-(3.5 * 3.5) * denom_inv);
    const float texel0to1ratio = mix(w1_5off / (w0_5off + w1_5off), 0.5, fragment_error_blurring);
    const float texel2to3ratio = mix(w3_5off / (w2_5off + w3_5off), 0.5, fragment_error_blurring);
    const float texel0to1ratio_nearest = w1off / (w0off + w1off);
    const float texel1to2ratio_nearest = w2off / (w1off + w2off);
    const vec2 sample0curr_texel_offset = vec2(0., 0.) + vec2(texel0to1ratio_nearest, texel0to1ratio_nearest);
    const vec2 sample0adjx_texel_offset = vec2(-1., 0.) + vec2(-texel1to2ratio_nearest, texel0to1ratio_nearest);
    const vec2 sample0adjy_texel_offset = vec2(0., -1.) + vec2(texel0to1ratio_nearest, -texel1to2ratio_nearest);
    const vec2 sample0diag_texel_offset = vec2(-1., -1.) + vec2(-texel1to2ratio_nearest, -texel1to2ratio_nearest);
    const vec2 sample1_texel_offset = vec2(2., 0.) + vec2(texel2to3ratio, texel0to1ratio);
    const vec2 sample2_texel_offset = vec2(0., 2.) + vec2(texel0to1ratio, texel2to3ratio);
    const vec2 sample3_texel_offset = vec2(2., 2.) + vec2(texel2to3ratio, texel2to3ratio);
    const float w0diag = exp(-dot(vec2(-2., -2.), vec2(-2., -2.)) * denom_inv) + exp(-dot(vec2(-2. + 1., -2.), vec2(-2. + 1., -2.)) * denom_inv) + exp(-dot(vec2(-2., -2. + 1.), vec2(-2., -2. + 1.)) * denom_inv) + exp(-dot(vec2(-2. + 1., -2. + 1.), vec2(-2. + 1., -2. + 1.)) * denom_inv);
    const float w0adjy = exp(-dot(vec2(0., -2.), vec2(0., -2.)) * denom_inv) + exp(-dot(vec2(0. + 1., -2.), vec2(0. + 1., -2.)) * denom_inv) + exp(-dot(vec2(0., -2. + 1.), vec2(0., -2. + 1.)) * denom_inv) + exp(-dot(vec2(0. + 1., -2. + 1.), vec2(0. + 1., -2. + 1.)) * denom_inv);
    const float w1adjy = exp(-dot(vec2(2., -2.), vec2(2., -2.)) * denom_inv) + exp(-dot(vec2(2. + 1., -2.), vec2(2. + 1., -2.)) * denom_inv) + exp(-dot(vec2(2., -2. + 1.), vec2(2., -2. + 1.)) * denom_inv) + exp(-dot(vec2(2. + 1., -2. + 1.), vec2(2. + 1., -2. + 1.)) * denom_inv);
    const float w0adjx = exp(-dot(vec2(-2., 0.), vec2(-2., 0.)) * denom_inv) + exp(-dot(vec2(-2. + 1., 0.), vec2(-2. + 1., 0.)) * denom_inv) + exp(-dot(vec2(-2., 0. + 1.), vec2(-2., 0. + 1.)) * denom_inv) + exp(-dot(vec2(-2. + 1., 0. + 1.), vec2(-2. + 1., 0. + 1.)) * denom_inv);
    const float w0curr = exp(-dot(vec2(0., 0.), vec2(0., 0.)) * denom_inv) + exp(-dot(vec2(0. + 1., 0.), vec2(0. + 1., 0.)) * denom_inv) + exp(-dot(vec2(0., 0. + 1.), vec2(0., 0. + 1.)) * denom_inv) + exp(-dot(vec2(0. + 1., 0. + 1.), vec2(0. + 1., 0. + 1.)) * denom_inv);
    const float w1curr = exp(-dot(vec2(2., 0.), vec2(2., 0.)) * denom_inv) + exp(-dot(vec2(2. + 1., 0.), vec2(2. + 1., 0.)) * denom_inv) + exp(-dot(vec2(2., 0. + 1.), vec2(2., 0. + 1.)) * denom_inv) + exp(-dot(vec2(2. + 1., 0. + 1.), vec2(2. + 1., 0. + 1.)) * denom_inv);
    const float w2adjx = exp(-dot(vec2(-2., 2.), vec2(-2., 2.)) * denom_inv) + exp(-dot(vec2(-2. + 1., 2.), vec2(-2. + 1., 2.)) * denom_inv) + exp(-dot(vec2(-2., 2. + 1.), vec2(-2., 2. + 1.)) * denom_inv) + exp(-dot(vec2(-2. + 1., 2. + 1.), vec2(-2. + 1., 2. + 1.)) * denom_inv);
    const float w2curr = exp(-dot(vec2(0., 2.), vec2(0., 2.)) * denom_inv) + exp(-dot(vec2(0. + 1., 2.), vec2(0. + 1., 2.)) * denom_inv) + exp(-dot(vec2(0., 2. + 1.), vec2(0., 2. + 1.)) * denom_inv) + exp(-dot(vec2(0. + 1., 2. + 1.), vec2(0. + 1., 2. + 1.)) * denom_inv);
    const float w3curr = exp(-dot(vec2(2., 2.), vec2(2., 2.)) * denom_inv) + exp(-dot(vec2(2. + 1., 2.), vec2(2. + 1., 2.)) * denom_inv) + exp(-dot(vec2(2., 2. + 1.), vec2(2., 2. + 1.)) * denom_inv) + exp(-dot(vec2(2. + 1., 2. + 1.), vec2(2. + 1., 2. + 1.)) * denom_inv);
    const float weight_sum_inv = 1. / (w0curr + w1curr + w2curr + w3curr + w0adjx + w2adjx + w0adjy + w1adjy + w0diag);
    const vec4 w0 = vec4(w0curr, w0adjx, w0adjy, w0diag);
    const vec2 dxdy_curr = dxdy * quad_vector.xy;
    const vec3 sample0curr = fragment_tex2D_linearize(tex, tex_uv.xy + dxdy_curr * sample0curr_texel_offset).rgb;
    const vec3 sample0adjx = fragment_tex2D_linearize(tex, tex_uv.xy + dxdy_curr * sample0adjx_texel_offset).rgb;
    const vec3 sample0adjy = fragment_tex2D_linearize(tex, tex_uv.xy + dxdy_curr * sample0adjy_texel_offset).rgb;
    const vec3 sample0diag = fragment_tex2D_linearize(tex, tex_uv.xy + dxdy_curr * sample0diag_texel_offset).rgb;
    const vec3 sample1curr = fragment_tex2Dlod_linearize(tex, tex_uv + fragment_uv2_to_uv4(dxdy_curr * sample1_texel_offset)).rgb;
    const vec3 sample2curr = fragment_tex2Dlod_linearize(tex, tex_uv + fragment_uv2_to_uv4(dxdy_curr * sample2_texel_offset)).rgb;
    const vec3 sample3curr = fragment_tex2Dlod_linearize(tex, tex_uv + fragment_uv2_to_uv4(dxdy_curr * sample3_texel_offset)).rgb;
    vec3 sample1adjx, sample1adjy, sample1diag;
    vec3 sample2adjx, sample2adjy, sample2diag;
    fragment_quad_gather(quad_vector, sample1curr, sample1adjx, sample1adjy, sample1diag);
    fragment_quad_gather(quad_vector, sample2curr, sample2adjx, sample2adjy, sample2diag);
    vec3 sum = vec3(0., 0., 0.);
    sum += mat4x3(sample0curr, sample0adjx, sample0adjy, sample0diag) * w0;
    sum += w1curr * sample1curr + w1adjy * sample1adjy + w2curr * sample2curr + w2adjx * sample2adjx + w3curr * sample3curr;
    return sum * weight_sum_inv;
}

