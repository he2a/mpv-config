vec4 fragment_gamma_impl(const vec4 s, const vec4 s_inv) {
    const vec4 g = vec4(1.1290683);
    const vec4 c0 = vec4(0.81091195);
    const vec4 c1 = vec4(0.48083547);
    const vec4 e = vec4(2.7182817);
    const vec4 sph = s + vec4(0.5);
    const vec4 lanczos_sum = c0 + c1 / (s + vec4(1.));
    const vec4 base = (sph + g) / e;
    return pow(base, sph) * lanczos_sum * s_inv;
}

