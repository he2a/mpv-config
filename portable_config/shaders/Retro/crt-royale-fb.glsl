    const vec2 mask_resize_tile_size = fragment_get_resized_mask_tile_size(true_viewport_size, mask_resize_video_size, false);
    if (mask_sample_mode < 0.5) {
        const vec2 mask_tile_uv_size = mask_resize_tile_size / mask_resize_texture_size;
        const vec2 skipped_tiles = fragment_mask_start_texels / mask_resize_tile_size;
        const vec2 mask_tile_start_uv = skipped_tiles * mask_tile_uv_size;
        mask_tiles_per_screen = true_viewport_size / mask_resize_tile_size;
        return vec4(mask_tile_start_uv, mask_tile_uv_size);
    } else {
        const vec2 mask_tile_uv_size = vec2(1.);
