vec3 vertex_get_gaussian_sigma(const vec3 color, const float sigma_range) {
    if (vertex_beam_spot_shape_function < 0.5) {
        return vec3(global.beam_min_sigma) + sigma_range * pow(color, vec3(global.beam_spot_power));
    } else {
        const vec3 color_minus_1 = color - vec3(1.);
        return vec3(global.beam_min_sigma) + sigma_range * sqrt(vec3(1.) - color_minus_1 * color_minus_1);
    }
}

vec3 vertex_get_generalized_gaussian_beta(const vec3 color, const float shape_range) {
    return global.beam_min_shape + shape_range * pow(color, vec3(global.beam_shape_power));
}

vec3 vertex_scanline_gaussian_integral_contrib(const vec3 dist, const vec3 color, const float pixel_height, const float sigma_range) {
    const vec3 sigma = vertex_get_gaussian_sigma(color, sigma_range);
    const vec3 ph_offset = vec3(pixel_height * 0.5);
    const vec3 denom_inv = 1. / (sigma * sqrt(2.));
    const vec3 integral_high = vertex_erf((dist + ph_offset) * denom_inv);
    const vec3 integral_low = vertex_erf((dist - ph_offset) * denom_inv);
    return color * 0.5 * (integral_high - integral_low) / pixel_height;
}

vec3 vertex_scanline_generalized_gaussian_integral_contrib(vec3 dist, vec3 color, float pixel_height, float sigma_range, float shape_range) {
    const vec3 alpha = sqrt(2.) * vertex_get_gaussian_sigma(color, sigma_range);
    const vec3 beta = vertex_get_generalized_gaussian_beta(color, shape_range);
    const vec3 alpha_inv = vec3(1.) / alpha;
    const vec3 s = vec3(1.) / beta;
    const vec3 ph_offset = vec3(pixel_height * 0.5);
    const vec3 gamma_s_inv = vec3(1.) / vertex_gamma_impl(s, beta);
    const vec3 dist1 = dist + ph_offset;
    const vec3 dist0 = dist - ph_offset;
    const vec3 integral_high = sign(dist1) * vertex_normalized_ligamma_impl(s, pow(abs(dist1) * alpha_inv, beta), beta, gamma_s_inv);
    const vec3 integral_low = sign(dist0) * vertex_normalized_ligamma_impl(s, pow(abs(dist0) * alpha_inv, beta), beta, gamma_s_inv);
    return color * 0.5 * (integral_high - integral_low) / pixel_height;
}

vec3 vertex_scanline_gaussian_sampled_contrib(const vec3 dist, const vec3 color, const float pixel_height, const float sigma_range) {
    const vec3 sigma = vertex_get_gaussian_sigma(color, sigma_range);
    const vec3 sigma_inv = vec3(1.) / sigma;
    const vec3 inner_denom_inv = 0.5 * sigma_inv * sigma_inv;
    const vec3 outer_denom_inv = sigma_inv / sqrt(2. * vertex_pi);
    if (vertex_beam_antialias_level > 0.5) {
        const vec3 sample_offset = vec3(pixel_height / 3.);
        const vec3 dist2 = dist + sample_offset;
        const vec3 dist3 = abs(dist - sample_offset);
        const vec3 scale = color / 3. * outer_denom_inv;
        const vec3 weight1 = exp(-(dist * dist) * inner_denom_inv);
        const vec3 weight2 = exp(-(dist2 * dist2) * inner_denom_inv);
        const vec3 weight3 = exp(-(dist3 * dist3) * inner_denom_inv);
        return scale * (weight1 + weight2 + weight3);
    } else {
        return color * exp(-(dist * dist) * inner_denom_inv) * outer_denom_inv;
    }
}

vec3 vertex_scanline_generalized_gaussian_sampled_contrib(vec3 dist, vec3 color, float pixel_height, float sigma_range, float shape_range) {
    const vec3 alpha = sqrt(2.) * vertex_get_gaussian_sigma(color, sigma_range);
    const vec3 beta = vertex_get_generalized_gaussian_beta(color, shape_range);
    const vec3 alpha_inv = vec3(1.) / alpha;
    const vec3 beta_inv = vec3(1.) / beta;
    const vec3 scale = color * beta * 0.5 * alpha_inv / vertex_gamma_impl(beta_inv, beta);
    if (vertex_beam_antialias_level > 0.5) {
        const vec3 sample_offset = vec3(pixel_height / 3.);
        const vec3 dist2 = dist + sample_offset;
        const vec3 dist3 = abs(dist - sample_offset);
        const vec3 weight1 = exp(-pow(abs(dist * alpha_inv), beta));
        const vec3 weight2 = exp(-pow(abs(dist2 * alpha_inv), beta));
        const vec3 weight3 = exp(-pow(abs(dist3 * alpha_inv), beta));
        return scale / 3. * (weight1 + weight2 + weight3);
    } else {
        return scale * exp(-pow(abs(dist * alpha_inv), beta));
    }
}

vec3 vertex_scanline_contrib(vec3 dist, vec3 color, float pixel_height, const float sigma_range, const float shape_range) {
    if (vertex_beam_generalized_gaussian) {
        if (vertex_beam_antialias_level > 1.5) {
            return vertex_scanline_generalized_gaussian_integral_contrib(dist, color, pixel_height, sigma_range, shape_range);
        } else {
            return vertex_scanline_generalized_gaussian_sampled_contrib(dist, color, pixel_height, sigma_range, shape_range);
        }
    } else {
        if (vertex_beam_antialias_level > 1.5) {
            return vertex_scanline_gaussian_integral_contrib(dist, color, pixel_height, sigma_range);
        } else {
            return vertex_scanline_gaussian_sampled_contrib(dist, color, pixel_height, sigma_range);
        }
    }
}

vec3 vertex_get_raw_interpolated_color(const vec3 color0, const vec3 color1, const vec3 color2, const vec3 color3, const vec4 weights) {
    return max(mat4x3(color0, color1, color2, color3) * weights, 0.);
}

vec3 vertex_get_interpolated_linear_color(const vec3 color0, const vec3 color1, const vec3 color2, const vec3 color3, const vec4 weights) {
    const float intermediate_gamma = vertex_get_intermediate_gamma();
    const vec3 linear_mixed_color = vertex_get_raw_interpolated_color(color0, color1, color2, color3, weights);
    const vec3 gamma_mixed_color = vertex_get_raw_interpolated_color(pow(color0, vec3(1. / intermediate_gamma)), pow(color1, vec3(1. / intermediate_gamma)), pow(color2, vec3(1. / intermediate_gamma)), pow(color3, vec3(1. / intermediate_gamma)), weights);
    return mix(gamma_mixed_color, linear_mixed_color, global.beam_horiz_linear_rgb_weight);
}

vec3 vertex_get_scanline_color(const sampler2D tex, const vec2 scanline_uv, const vec2 uv_step_x, const vec4 weights) {
    const vec3 color1 = texture(tex, scanline_uv).rgb;
    const vec3 color2 = texture(tex, scanline_uv + uv_step_x).rgb;
    vec3 color0 = vec3(0.);
    vec3 color3 = vec3(0.);
    if (global.beam_horiz_filter > 0.5) {
        color0 = texture(tex, scanline_uv - uv_step_x).rgb;
        color3 = texture(tex, scanline_uv + 2. * uv_step_x).rgb;
    }
    return vertex_get_interpolated_linear_color(color0, color1, color2, color3, weights);
}

vec3 vertex_sample_single_scanline_horizontal(const sampler2D tex, const vec2 tex_uv, const vec2 tex_size, const vec2 texture_size_inv) {
    const vec2 curr_texel = tex_uv * tex_size;
    const vec2 prev_texel = floor(curr_texel - vec2(vertex_under_half)) + vec2(0.5);
    const vec2 prev_texel_hor = vec2(prev_texel.x, curr_texel.y);
    const vec2 prev_texel_hor_uv = prev_texel_hor * texture_size_inv;
    const float prev_dist = curr_texel.x - prev_texel_hor.x;
    const vec4 sample_dists = vec4(1. + prev_dist, prev_dist, 1. - prev_dist, 2. - prev_dist);
    vec4 weights;
    if (global.beam_horiz_filter < 0.5) {
        const float x = sample_dists.y;
        const float w2 = x * x * x * (x * (x * 6. - 15.) + 10.);
        weights = vec4(0., 1. - w2, w2, 0.);
    } else if (global.beam_horiz_filter < 1.5) {
        float inner_denom_inv = 1. / (2. * global.beam_horiz_sigma * global.beam_horiz_sigma);
        weights = exp(-(sample_dists * sample_dists) * inner_denom_inv);
    } else {
        const vec4 pi_dists = max(abs(sample_dists * vertex_pi), 0.000015258789);
        weights = 2. * sin(pi_dists) * sin(pi_dists * 0.5) / (pi_dists * pi_dists);
    }
    const vec4 final_weights = weights / dot(weights, vec4(1.));
    const vec2 uv_step_x = vec2(texture_size_inv.x, 0.);
    return vertex_get_scanline_color(tex, prev_texel_hor_uv, uv_step_x, final_weights);
}

vec3 vertex_sample_rgb_scanline_horizontal(const sampler2D tex, const vec2 tex_uv, const vec2 tex_size, const vec2 texture_size_inv) {
    if (vertex_beam_misconvergence) {
        const vec3 convergence_offsets_rgb = vertex_get_convergence_offsets_x_vector();
        const vec3 offset_u_rgb = convergence_offsets_rgb * texture_size_inv.xxx;
        const vec2 scanline_uv_r = tex_uv - vec2(offset_u_rgb.r, 0.);
        const vec2 scanline_uv_g = tex_uv - vec2(offset_u_rgb.g, 0.);
        const vec2 scanline_uv_b = tex_uv - vec2(offset_u_rgb.b, 0.);
        const vec3 sample_r = vertex_sample_single_scanline_horizontal(tex, scanline_uv_r, tex_size, texture_size_inv);
        const vec3 sample_g = vertex_sample_single_scanline_horizontal(tex, scanline_uv_g, tex_size, texture_size_inv);
        const vec3 sample_b = vertex_sample_single_scanline_horizontal(tex, scanline_uv_b, tex_size, texture_size_inv);
        return vec3(sample_r.r, sample_g.g, sample_b.b);
    } else {
        return vertex_sample_single_scanline_horizontal(tex, tex_uv, tex_size, texture_size_inv);
    }
}

vec2 vertex_get_last_scanline_uv(const vec2 tex_uv, const vec2 tex_size, const vec2 texture_size_inv, const vec2 il_step_multiple, const float FrameCount, out float dist) {
    const float field_offset = floor(il_step_multiple.y * 0.75) * mod(FrameCount + float(global.interlace_bff), 2.);
    const vec2 curr_texel = tex_uv * tex_size;
    const vec2 prev_texel_num = floor(curr_texel - vec2(vertex_under_half));
    const float wrong_field = mod(prev_texel_num.y + field_offset, il_step_multiple.y);
    const vec2 scanline_texel_num = prev_texel_num - vec2(0., wrong_field);
    const vec2 scanline_texel = scanline_texel_num + vec2(0.5);
    const vec2 scanline_uv = scanline_texel * texture_size_inv;
    dist = (curr_texel.y - scanline_texel.y) / il_step_multiple.y;
    return scanline_uv;
}

bool vertex_is_interlaced(float num_lines) {
    if (vertex_interlace_detect) {
        const bool sd_interlace = num_lines > 288.5 && num_lines < 576.5;
        const bool hd_interlace = bool(global.interlace_1080i) ? num_lines > 1079.5 && num_lines < 1080.5 : false;
        return sd_interlace || hd_interlace;
    } else {
        return false;
    }
}

vec4 Position = vec4(HOOKED_pos, 0., 1.);
vec2 TexCoord = HOOKED_pos;
vec2 tex_uv;
vec2 uv_step;
vec2 il_step_multiple;
float pixel_height_in_scanlines;
void vertex_main() {
    vertex_gl_Position = global.MVP * Position;
    tex_uv = TexCoord * 1.00001;
    vec2 video_size_ = params.SourceSize.xy.xy;
    const float y_step = 1. + float(vertex_is_interlaced(video_size_.y));
    il_step_multiple = vec2(1., y_step);
    uv_step = il_step_multiple / params.SourceSize.xy;
    const float ph = video_size_.y / params.OutputSize.xy.y / il_step_multiple.y;
    pixel_height_in_scanlines = ph;
}

