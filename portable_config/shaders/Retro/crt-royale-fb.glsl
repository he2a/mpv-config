    const vec3 sample0adjy = fragment_tex2D_linearize(tex, tex_uv.xy + dxdy_curr * sample0adjy_texel_offset).rgb;
    const vec3 sample0diag = fragment_tex2D_linearize(tex, tex_uv.xy + dxdy_curr * sample0diag_texel_offset).rgb;
    const vec3 sample1curr = fragment_tex2Dlod_linearize(tex, tex_uv + fragment_uv2_to_uv4(dxdy_curr * sample1_texel_offset)).rgb;
    const vec3 sample2curr = fragment_tex2Dlod_linearize(tex, tex_uv + fragment_uv2_to_uv4(dxdy_curr * sample2_texel_offset)).rgb;
    const vec3 sample3curr = fragment_tex2Dlod_linearize(tex, tex_uv + fragment_uv2_to_uv4(dxdy_curr * sample3_texel_offset)).rgb;
    vec3 sample1adjx, sample1adjy, sample1diag;
    vec3 sample2adjx, sample2adjy, sample2diag;
    fragment_quad_gather(quad_vector, sample1curr, sample1adjx, sample1adjy, sample1diag);
    fragment_quad_gather(quad_vector, sample2curr, sample2adjx, sample2adjy, sample2diag);
    vec3 sum = vec3(0., 0., 0.);
    sum += mat4x3(sample0curr, sample0adjx, sample0adjy, sample0diag) * w0;
