vec2 vertex_get_resized_mask_tile_size(const vec2 estimated_viewport_size, const vec2 estimated_mask_resize_output_size, const bool solemnly_swear_same_inputs_for_every_pass) {
    const float tile_aspect_ratio_inv = vertex_mask_resize_src_lut_size.y / vertex_mask_resize_src_lut_size.x;
    const float tile_aspect_ratio = 1. / tile_aspect_ratio_inv;
    const vec2 tile_aspect = vec2(1., tile_aspect_ratio_inv);
    const float desired_tile_size_x = vertex_mask_triads_per_tile * mix(global.mask_triad_size_desired, estimated_viewport_size.x / global.mask_num_triads_desired, global.mask_specify_num_triads);
    if (vertex_get_mask_sample_mode() > 0.5) {
