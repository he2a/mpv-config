vec2 fragment_get_first_texel_tile_uv_and_dist(const vec2 tex_uv, const vec2 tex_size, const float dr, const float input_tiles_per_texture_r, const float samples, const bool vertical) {
    const vec2 curr_texel = tex_uv * tex_size;
