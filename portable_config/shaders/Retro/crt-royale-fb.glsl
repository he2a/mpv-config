    const float w1 = exp(-1. * denom_inv);
    const float w2 = exp(-4. * denom_inv);
    const float w3 = exp(-9. * denom_inv);
    const float w4 = exp(-16. * denom_inv);
    const float w5 = exp(-25. * denom_inv);
