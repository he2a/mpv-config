    const vec3 base = (sph + g) / e;
    return pow(base, sph) * lanczos_sum * s_inv;
}

vec2 vertex_gamma_impl(const vec2 s, const vec2 s_inv) {
    const vec2 g = vec2(1.1290683);
    const vec2 c0 = vec2(0.81091195);
    const vec2 c1 = vec2(0.48083547);
    const vec2 e = vec2(2.7182817);
    const vec2 sph = s + vec2(0.5);
    const vec2 lanczos_sum = c0 + c1 / (s + vec2(1.));
    const vec2 base = (sph + g) / e;
    return pow(base, sph) * lanczos_sum * s_inv;
}

float vertex_gamma_impl(const float s, const float s_inv) {
    const float g = 1.1290683;
    const float c0 = 0.81091195;
    const float c1 = 0.48083547;
    const float e = 2.7182817;
    const float sph = s + 0.5;
    const float lanczos_sum = c0 + c1 / (s + 1.);
    const float base = (sph + g) / e;
    return pow(base, sph) * lanczos_sum * s_inv;
}

vec4 vertex_gamma(const vec4 s) {
    return vertex_gamma_impl(s, vec4(1.) / s);
}

vec3 vertex_gamma(const vec3 s) {
    return vertex_gamma_impl(s, vec3(1.) / s);
}

vec2 vertex_gamma(const vec2 s) {
    return vertex_gamma_impl(s, vec2(1.) / s);
}

float vertex_gamma(const float s) {
    return vertex_gamma_impl(s, 1. / s);
}

vec4 vertex_ligamma_small_z_impl(const vec4 s, const vec4 z, const vec4 s_inv) {
    const vec4 scale = pow(z, s);
    vec4 sum = s_inv;
    const vec4 z_sq = z * z;
    const vec4 denom1 = s + vec4(1.);
    const vec4 denom2 = 2. * s + vec4(4.);
    const vec4 denom3 = 6. * s + vec4(18.);
    sum -= z / denom1;
    sum += z_sq / denom2;
    sum -= z * z_sq / denom3;
    return scale * sum;
}

vec3 vertex_ligamma_small_z_impl(const vec3 s, const vec3 z, const vec3 s_inv) {
    const vec3 scale = pow(z, s);
    vec3 sum = s_inv;
    const vec3 z_sq = z * z;
    const vec3 denom1 = s + vec3(1.);
    const vec3 denom2 = 2. * s + vec3(4.);
    const vec3 denom3 = 6. * s + vec3(18.);
    sum -= z / denom1;
    sum += z_sq / denom2;
    sum -= z * z_sq / denom3;
    return scale * sum;
}

vec2 vertex_ligamma_small_z_impl(const vec2 s, const vec2 z, const vec2 s_inv) {
    const vec2 scale = pow(z, s);
    vec2 sum = s_inv;
    const vec2 z_sq = z * z;
    const vec2 denom1 = s + vec2(1.);
    const vec2 denom2 = 2. * s + vec2(4.);
    const vec2 denom3 = 6. * s + vec2(18.);
    sum -= z / denom1;
    sum += z_sq / denom2;
    sum -= z * z_sq / denom3;
