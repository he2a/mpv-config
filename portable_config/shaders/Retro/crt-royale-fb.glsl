    const vec4 ssd_fai = fragment_get_subpixel_support_diam_and_final_axis_importance();
    const vec2 subpixel_support_diameter = ssd_fai.xy;
    const vec2 final_axis_importance = ssd_fai.zw;
    const vec2 xy_step = vec2(1., 1.) / grid_size * subpixel_support_diameter;
    const vec2 xy_start_offset = vec2(0.5 - grid_size * 0.5, 0.5 - grid_size * 0.5) * xy_step;
    const vec2 xy_offset0 = xy_start_offset + vec2(2., 0.) * xy_step;
    const vec2 xy_offset1 = xy_start_offset + vec2(0., 1.) * xy_step;
    const vec3 w0 = fragment_eval_unorm_rgb_weights(xy_offset0, final_axis_importance);
    const vec3 w1 = fragment_eval_unorm_rgb_weights(xy_offset1, final_axis_importance);
    const vec3 w2 = w1.bgr;
    const vec3 w3 = w0.bgr;
    const vec3 half_sum = w0 + w1;
    const vec3 w_sum = half_sum + half_sum.bgr;
    const vec3 w_sum_inv = vec3(1., 1., 1.) / w_sum;
    const mat2x2 true_pixel_to_tex_uv = mat2x2(pixel_to_tex_uv * fragment_aa_pixel_diameter);
    const vec2 frame_sign = fragment_get_frame_sign(frame);
    const vec2 uv_offset0 = xy_offset0 * frame_sign * true_pixel_to_tex_uv;
    const vec2 uv_offset1 = xy_offset1 * frame_sign * true_pixel_to_tex_uv;
    const vec3 sample0 = fragment_tex2Daa_tiled_linearize(tex, tex_uv + uv_offset0).rgb;
    const vec3 sample1 = fragment_tex2Daa_tiled_linearize(tex, tex_uv + uv_offset1).rgb;
    const vec3 sample2 = fragment_tex2Daa_tiled_linearize(tex, tex_uv - uv_offset1).rgb;
    const vec3 sample3 = fragment_tex2Daa_tiled_linearize(tex, tex_uv - uv_offset0).rgb;
    return w_sum_inv * (w0 * sample0 + w1 * sample1 + w2 * sample2 + w3 * sample3);
