const float fragment_bloom_diff_thresh = 1. / 256.;
float fragment_get_min_sigma_to_blur_triad(const float triad_size, const float thresh) {
    return -0.05168 + 0.6113 * triad_size - 1.122 * triad_size * sqrt(0.000416 + thresh);
}

float fragment_get_absolute_scale_blur_sigma(const float thresh) {
    return fragment_bloom_approx_scale_x / fragment_max_viewport_size_x * fragment_get_min_sigma_to_blur_triad(fragment_max_viewport_size_x / fragment_min_allowed_viewport_triads.x, thresh);
}

float fragment_get_center_weight(const float sigma) {
    return fragment_get_fast_gaussian_weight_sum_inv(sigma);
}

