const float fragment_bloom_diff_thresh = 1. / 256.;
float fragment_get_min_sigma_to_blur_triad(const float triad_size, const float thresh) {
    return -0.05168 + 0.6113 * triad_size - 1.122 * triad_size * sqrt(0.000416 + thresh);
}

float fragment_get_absolute_scale_blur_sigma(const float thresh) {
    return fragment_bloom_approx_scale_x / fragment_max_viewport_size_x * fragment_get_min_sigma_to_blur_triad(fragment_max_viewport_size_x / fragment_min_allowed_viewport_triads.x, thresh);
}

float fragment_get_center_weight(const float sigma) {
    return fragment_get_fast_gaussian_weight_sum_inv(sigma);
}

vec3 fragment_tex2DblurNfast(const sampler2D texture, const vec2 tex_uv, const vec2 dxdy, const float sigma) {
    return fragment_tex2Dblur17fast(texture, tex_uv, dxdy, sigma);
}

float fragment_get_bloom_approx_sigma(const float output_size_x_runtime, const float estimated_viewport_size_x) {
    const float mask_num_triads_static = max(fragment_min_allowed_viewport_triads.x, fragment_mask_num_triads_desired_static);
    const float mask_num_triads_from_size = estimated_viewport_size_x / global.mask_triad_size_desired;
    const float mask_num_triads_runtime = max(fragment_min_allowed_viewport_triads.x, mix(mask_num_triads_from_size, global.mask_num_triads_desired, global.mask_specify_num_triads));
    const float fragment_max_viewport_size_x = 1080. * 1024. * (4. / 3.);
    if (fragment_bloom_approx_filter > 1.5) {
        const float asymptotic_triad_size = fragment_max_viewport_size_x / mask_num_triads_runtime;
        const float asymptotic_sigma = fragment_get_min_sigma_to_blur_triad(asymptotic_triad_size, fragment_bloom_diff_thresh);
        const float bloom_approx_sigma = asymptotic_sigma * output_size_x_runtime / fragment_max_viewport_size_x;
        return length(vec2(bloom_approx_sigma, global.beam_max_sigma));
    } else {
        const float output_size_x_static = fragment_bloom_approx_size_x_for_fake;
        const float asymptotic_triad_size = fragment_max_viewport_size_x / mask_num_triads_static;
        const float asymptotic_sigma = fragment_get_min_sigma_to_blur_triad(asymptotic_triad_size, fragment_bloom_diff_thresh);
        const float bloom_approx_sigma = asymptotic_sigma * output_size_x_static / fragment_max_viewport_size_x;
        return length(vec2(bloom_approx_sigma, fragment_beam_max_sigma_static));
