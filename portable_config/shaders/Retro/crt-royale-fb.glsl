float fragment_uigamma_large_z_impl(const float s, const float z) {
    const float numerator = pow(z, s) * exp(-z);
    float denom = 7. + z - s;
    denom = 5. + z - s + (3. * s - 9.) / denom;
    denom = 3. + z - s + (2. * s - 4.) / denom;
    denom = 1. + z - s + (s - 1.) / denom;
    return numerator / denom;
}

vec4 fragment_normalized_ligamma_impl(const vec4 s, const vec4 z, const vec4 s_inv, const vec4 gamma_s_inv) {
    const vec4 thresh = vec4(0.775075);
    bvec4 z_is_large;
    z_is_large.x = z.x > thresh.x;
    z_is_large.y = z.y > thresh.y;
    z_is_large.z = z.z > thresh.z;
    z_is_large.w = z.w > thresh.w;
    const vec4 large_z = vec4(1.) - fragment_uigamma_large_z_impl(s, z) * gamma_s_inv;
    const vec4 small_z = fragment_ligamma_small_z_impl(s, z, s_inv) * gamma_s_inv;
    bvec4 inverse_z_is_large = not(z_is_large);
    return large_z * vec4(z_is_large) + small_z * vec4(inverse_z_is_large);
}

