vec3 fragment_downsample_vertical_sinc_tiled(const sampler2D tex, const vec2 tex_uv, const vec2 tex_size, const float dr, const float magnification_scale, const float tile_size_uv_r) {
    const int samples = int(fragment_max_sinc_resize_samples_m4);
    const float input_tiles_per_texture_r = 1. / tile_size_uv_r;
    const vec2 first_texel_tile_r_and_dist = fragment_get_first_texel_tile_uv_and_dist(tex_uv, tex_size, dr, input_tiles_per_texture_r, samples, true);
    const vec4 first_texel_tile_uv_rrrr = first_texel_tile_r_and_dist.xxxx;
    const vec4 first_dist_unscaled = first_texel_tile_r_and_dist.yyyy;
    const float tile_dr = dr * input_tiles_per_texture_r;
    int i_base = 0;
    vec4 weight_sum = vec4(0.);
    vec3 pixel_color = vec3(0.);
    const int i_step = 4;
    for (int i = 0; i < samples; i += i_step) {
        const vec4 true_i = vec4(i_base + i) + vec4(0., 1., 2., 3.);
        const vec4 tile_uv_r = fract(first_texel_tile_uv_rrrr + true_i * tile_dr);
        const vec4 tex_uv_r = tile_uv_r * tile_size_uv_r;
        ;
        const vec3 new_sample0 = fragment_tex2Dlod0try(tex, vec2(tex_uv.x, tex_uv_r.x)).rgb;
        const vec3 new_sample1 = fragment_tex2Dlod0try(tex, vec2(tex_uv.x, tex_uv_r.y)).rgb;
        const vec3 new_sample2 = fragment_tex2Dlod0try(tex, vec2(tex_uv.x, tex_uv_r.z)).rgb;
        const vec3 new_sample3 = fragment_tex2Dlod0try(tex, vec2(tex_uv.x, tex_uv_r.w)).rgb;
        const vec4 dist = magnification_scale * abs(first_dist_unscaled - true_i);
        const vec4 pi_dist = fragment_pi * dist;
        const vec4 pi_dist_over_lobes = fragment_pi_over_lobes * dist;
        const vec4 weights = min(sin(pi_dist) * sin(pi_dist_over_lobes) / (pi_dist * pi_dist_over_lobes), vec4(1.));
