vec2 blur_dxdy;
void vertex_main() {
    vertex_gl_Position = global.MVP * Position;
    tex_uv = TexCoord;
    const vec2 dxdy_scale = params.SourceSize.xy / params.OutputSize.xy;
    const vec2 dxdy = dxdy_scale / params.SourceSize.xy;
