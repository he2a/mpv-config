vec3 fragment_tex2Daa_debug_dynamic(const sampler2D tex, const vec2 tex_uv, const mat2x2 pixel_to_tex_uv, const float frame) {
    const int grid_size = 8;
    fragment_assign_aa_cubic_constants();
    const vec4 ssd_fai = fragment_get_subpixel_support_diam_and_final_axis_importance();
    const vec2 subpixel_support_diameter = ssd_fai.xy;
    const vec2 final_axis_importance = ssd_fai.zw;
    const float grid_radius_in_samples = (float(grid_size) - 1.) / 2.;
    const vec2 filter_space_offset_step = subpixel_support_diameter / vec2(grid_size);
    const vec2 sample0_filter_space_offset = -grid_radius_in_samples * filter_space_offset_step;
    vec3 weights[64];
    vec3 weight_sum = vec3(0., 0., 0.);
    for (int i = 0; i < grid_size; ++i) {
        for (int j = 0; j < grid_size; ++j) {
            const vec2 offset = sample0_filter_space_offset + vec2(j, i) * filter_space_offset_step;
            const vec3 weight = fragment_eval_unorm_rgb_weights(offset, final_axis_importance);
            weights[i * grid_size + j] = weight;
            weight_sum += weight;
        }
    }
    const mat2x2 true_pixel_to_tex_uv = mat2x2(pixel_to_tex_uv * fragment_aa_pixel_diameter);
    const vec2 uv_offset_step_x = vec2(filter_space_offset_step.x, 0.) * true_pixel_to_tex_uv;
    const vec2 uv_offset_step_y = vec2(0., filter_space_offset_step.y) * true_pixel_to_tex_uv;
    const vec2 sample0_uv_offset = -grid_radius_in_samples * (uv_offset_step_x + uv_offset_step_y);
    const vec2 sample0_uv = tex_uv + sample0_uv_offset;
    vec3 sum = vec3(0., 0., 0.);
    const vec3 weight_sum_inv = vec3(1.) / weight_sum;
    for (int i = 0; i < grid_size; ++i) {
        const vec2 row_i_first_sample_uv = sample0_uv + i * uv_offset_step_y;
        for (int j = 0; j < grid_size; ++j) {
            const vec2 sample_uv = row_i_first_sample_uv + j * uv_offset_step_x;
            sum += weights[i * grid_size + j] * fragment_tex2Daa_tiled_linearize(tex, sample_uv).rgb;
        }
    }
    return sum * weight_sum_inv;
}

