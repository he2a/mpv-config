    const vec2 final_axis_importance = ssd_fai.zw;
    const vec2 xy_step = vec2(1.) / grid_size * subpixel_support_diameter;
    const vec2 xy_start_offset = vec2(0.5 - grid_size * 0.5) * xy_step;
    const vec2 xy_offset0 = xy_start_offset + vec2(1., 0.) * xy_step;
    const vec2 xy_offset1 = xy_start_offset + vec2(4., 1.) * xy_step;
    const vec2 xy_offset2 = xy_start_offset + vec2(2., 2.) * xy_step;
    const vec3 w0 = fragment_eval_unorm_rgb_weights(xy_offset0, final_axis_importance);
    const vec3 w1 = fragment_eval_unorm_rgb_weights(xy_offset1, final_axis_importance);
    const vec3 w2 = fragment_eval_unorm_rgb_weights(xy_offset2, final_axis_importance);
