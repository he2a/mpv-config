void vertex_main() {
    vertex_gl_Position = global.MVP * Position;
    tex_uv = TexCoord * 1.00001;
    uv_step = vec2(1.) / params.SourceSize.xy;
    const vec2 _video_size = params.SourceSize.xy;
    interlaced = float(vertex_is_interlaced(_video_size.y));
}

