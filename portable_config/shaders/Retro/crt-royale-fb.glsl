float fragment_get_bloom_approx_sigma(const float output_size_x_runtime, const float estimated_viewport_size_x) {
    const float mask_num_triads_static = max(fragment_min_allowed_viewport_triads.x, fragment_mask_num_triads_desired_static);
    const float mask_num_triads_from_size = estimated_viewport_size_x / global.mask_triad_size_desired;
    const float mask_num_triads_runtime = max(fragment_min_allowed_viewport_triads.x, mix(mask_num_triads_from_size, global.mask_num_triads_desired, global.mask_specify_num_triads));
    const float fragment_max_viewport_size_x = 1080. * 1024. * (4. / 3.);
    if (fragment_bloom_approx_filter > 1.5) {
        const float asymptotic_triad_size = fragment_max_viewport_size_x / mask_num_triads_runtime;
        const float asymptotic_sigma = fragment_get_min_sigma_to_blur_triad(asymptotic_triad_size, fragment_bloom_diff_thresh);
        const float bloom_approx_sigma = asymptotic_sigma * output_size_x_runtime / fragment_max_viewport_size_x;
        return length(vec2(bloom_approx_sigma, global.beam_max_sigma));
    } else {
        const float output_size_x_static = fragment_bloom_approx_size_x_for_fake;
        const float asymptotic_triad_size = fragment_max_viewport_size_x / mask_num_triads_static;
        const float asymptotic_sigma = fragment_get_min_sigma_to_blur_triad(asymptotic_triad_size, fragment_bloom_diff_thresh);
        const float bloom_approx_sigma = asymptotic_sigma * output_size_x_static / fragment_max_viewport_size_x;
        return length(vec2(bloom_approx_sigma, fragment_beam_max_sigma_static));
    }
}

float fragment_get_final_bloom_sigma(const float bloom_sigma_runtime) {
    const float bloom_sigma_optimistic = fragment_get_min_sigma_to_blur_triad(fragment_mask_triad_size_desired_static, fragment_bloom_diff_thresh);
    return bloom_sigma_runtime;
}

vec3 fragment_tex2Dresize_gaussian4x4(sampler2D tex, vec2 tex_uv, vec2 dxdy, vec2 tex_size, vec2 texture_size_inv, vec2 tex_uv_to_pixel_scale, float sigma) {
    const float denom_inv = 0.5 / (sigma * sigma);
    const vec2 curr_texel = tex_uv * tex_size;
    const vec2 prev_texel = floor(curr_texel - vec2(fragment_under_half)) + vec2(0.5);
    const vec2 prev_texel_uv = prev_texel * texture_size_inv;
    const vec2 snap = vec2(dxdy.x <= texture_size_inv.x, dxdy.y <= texture_size_inv.y);
    const vec2 sample5_downsize_uv = tex_uv - 0.5 * dxdy;
    const vec2 sample5_uv = mix(sample5_downsize_uv, prev_texel_uv, snap);
    const vec2 dx = vec2(dxdy.x, 0.);
    const vec2 sample0_uv = sample5_uv - dxdy;
    const vec2 sample10_uv = sample5_uv + dxdy;
    const vec2 sample15_uv = sample5_uv + 2. * dxdy;
    const vec2 sample1_uv = sample0_uv + dx;
    const vec2 sample2_uv = sample0_uv + 2. * dx;
    const vec2 sample3_uv = sample0_uv + 3. * dx;
    const vec2 sample4_uv = sample5_uv - dx;
    const vec2 sample6_uv = sample5_uv + dx;
    const vec2 sample7_uv = sample5_uv + 2. * dx;
    const vec2 sample8_uv = sample10_uv - 2. * dx;
    const vec2 sample9_uv = sample10_uv - dx;
    const vec2 sample11_uv = sample10_uv + dx;
    const vec2 sample12_uv = sample15_uv - 3. * dx;
    const vec2 sample13_uv = sample15_uv - 2. * dx;
    const vec2 sample14_uv = sample15_uv - dx;
    vec3 sample0 = fragment_tex2D_linearize(tex, sample0_uv).rgb;
    vec3 sample1 = fragment_tex2D_linearize(tex, sample1_uv).rgb;
    vec3 sample2 = fragment_tex2D_linearize(tex, dx).rgb;
    vec3 sample3 = fragment_tex2D_linearize(tex, sample3_uv).rgb;
    vec3 sample4 = fragment_tex2D_linearize(tex, sample4_uv).rgb;
    vec3 sample5 = fragment_tex2D_linearize(tex, sample5_uv).rgb;
    vec3 sample6 = fragment_tex2D_linearize(tex, sample6_uv).rgb;
    vec3 sample7 = fragment_tex2D_linearize(tex, sample7_uv).rgb;
    vec3 sample8 = fragment_tex2D_linearize(tex, sample8_uv).rgb;
    vec3 sample9 = fragment_tex2D_linearize(tex, sample9_uv).rgb;
    vec3 sample10 = fragment_tex2D_linearize(tex, sample10_uv).rgb;
    vec3 sample11 = fragment_tex2D_linearize(tex, sample11_uv).rgb;
    vec3 sample12 = fragment_tex2D_linearize(tex, sample12_uv).rgb;
    vec3 sample13 = fragment_tex2D_linearize(tex, sample13_uv).rgb;
    vec3 sample14 = fragment_tex2D_linearize(tex, sample14_uv).rgb;
    vec3 sample15 = fragment_tex2D_linearize(tex, sample15_uv).rgb;
    const vec2 dest_pixel = tex_uv * tex_uv_to_pixel_scale;
    const vec2 sample0_offset = sample0_uv * tex_uv_to_pixel_scale - dest_pixel;
    const vec2 sample1_offset = sample1_uv * tex_uv_to_pixel_scale - dest_pixel;
    const vec2 sample2_offset = sample2_uv * tex_uv_to_pixel_scale - dest_pixel;
    const vec2 sample3_offset = sample3_uv * tex_uv_to_pixel_scale - dest_pixel;
    const vec2 sample4_offset = sample4_uv * tex_uv_to_pixel_scale - dest_pixel;
    const vec2 sample5_offset = sample5_uv * tex_uv_to_pixel_scale - dest_pixel;
    const vec2 sample6_offset = sample6_uv * tex_uv_to_pixel_scale - dest_pixel;
    const vec2 sample7_offset = sample7_uv * tex_uv_to_pixel_scale - dest_pixel;
    const vec2 sample8_offset = sample8_uv * tex_uv_to_pixel_scale - dest_pixel;
    const vec2 sample9_offset = sample9_uv * tex_uv_to_pixel_scale - dest_pixel;
    const vec2 sample10_offset = sample10_uv * tex_uv_to_pixel_scale - dest_pixel;
    const vec2 sample11_offset = sample11_uv * tex_uv_to_pixel_scale - dest_pixel;
    const vec2 sample12_offset = sample12_uv * tex_uv_to_pixel_scale - dest_pixel;
    const vec2 sample13_offset = sample13_uv * tex_uv_to_pixel_scale - dest_pixel;
    const vec2 sample14_offset = sample14_uv * tex_uv_to_pixel_scale - dest_pixel;
    const vec2 sample15_offset = sample15_uv * tex_uv_to_pixel_scale - dest_pixel;
    const float w0 = exp(-dot(sample0_offset, sample0_offset) * denom_inv);
    const float w1 = exp(-dot(sample1_offset, sample1_offset) * denom_inv);
    const float w2 = exp(-dot(sample2_offset, sample2_offset) * denom_inv);
    const float w3 = exp(-dot(sample3_offset, sample3_offset) * denom_inv);
    const float w4 = exp(-dot(sample4_offset, sample4_offset) * denom_inv);
    const float w5 = exp(-dot(sample5_offset, sample5_offset) * denom_inv);
    const float w6 = exp(-dot(sample6_offset, sample6_offset) * denom_inv);
    const float w7 = exp(-dot(sample7_offset, sample7_offset) * denom_inv);
    const float w8 = exp(-dot(sample8_offset, sample8_offset) * denom_inv);
    const float w9 = exp(-dot(sample9_offset, sample9_offset) * denom_inv);
    const float w10 = exp(-dot(sample10_offset, sample10_offset) * denom_inv);
    const float w11 = exp(-dot(sample11_offset, sample11_offset) * denom_inv);
    const float w12 = exp(-dot(sample12_offset, sample12_offset) * denom_inv);
    const float w13 = exp(-dot(sample13_offset, sample13_offset) * denom_inv);
    const float w14 = exp(-dot(sample14_offset, sample14_offset) * denom_inv);
    const float w15 = exp(-dot(sample15_offset, sample15_offset) * denom_inv);
    const float weight_sum_inv = 1. / (w0 + w1 + w2 + w3 + w4 + w5 + w6 + w7 + w8 + w9 + w10 + w11 + w12 + w13 + w14 + w15);
    const vec3 sum = w0 * sample0 + w1 * sample1 + w2 * sample2 + w3 * sample3 + w4 * sample4 + w5 * sample5 + w6 * sample6 + w7 * sample7 + w8 * sample8 + w9 * sample9 + w10 * sample10 + w11 * sample11 + w12 * sample12 + w13 * sample13 + w14 * sample14 + w15 * sample15;
    return sum * weight_sum_inv;
}

void fragment_main() {
    const vec2 texture_size_ = params.SourceSize.xy;
    vec2 tex_uv_r, tex_uv_g, tex_uv_b;
    if (fragment_beam_misconvergence) {
        const vec2 uv_scanline_step = uv_scanline_step;
        const vec2 convergence_offsets_r = fragment_get_convergence_offsets_r_vector();
        const vec2 convergence_offsets_g = fragment_get_convergence_offsets_g_vector();
        const vec2 convergence_offsets_b = fragment_get_convergence_offsets_b_vector();
        tex_uv_r = tex_uv - convergence_offsets_r * uv_scanline_step;
        tex_uv_g = tex_uv - convergence_offsets_g * uv_scanline_step;
        tex_uv_b = tex_uv - convergence_offsets_b * uv_scanline_step;
    }
    const float bloom_approx_sigma = fragment_get_bloom_approx_sigma(params.OutputSize.xy.x, estimated_viewport_size_x);
    vec3 color_r, color_g, color_b, color;
    if (fragment_bloom_approx_filter > 1.5) {
        if (fragment_beam_misconvergence) {
            color_r = fragment_tex2Dresize_gaussian4x4(ORIG_LINEARIZED, tex_uv_r, blur_dxdy, texture_size_, texture_size_inv, tex_uv_to_pixel_scale, bloom_approx_sigma);
            color_g = fragment_tex2Dresize_gaussian4x4(ORIG_LINEARIZED, tex_uv_g, blur_dxdy, texture_size_, texture_size_inv, tex_uv_to_pixel_scale, bloom_approx_sigma);
            color_b = fragment_tex2Dresize_gaussian4x4(ORIG_LINEARIZED, tex_uv_b, blur_dxdy, texture_size_, texture_size_inv, tex_uv_to_pixel_scale, bloom_approx_sigma);
        } else {
            color = fragment_tex2Dresize_gaussian4x4(ORIG_LINEARIZED, tex_uv, blur_dxdy, texture_size_, texture_size_inv, tex_uv_to_pixel_scale, bloom_approx_sigma);
        }
    } else if (fragment_bloom_approx_filter > 0.5) {
        if (fragment_beam_misconvergence) {
            color_r = fragment_tex2Dblur3x3resize(ORIG_LINEARIZED, tex_uv_r, blur_dxdy, bloom_approx_sigma);
            color_g = fragment_tex2Dblur3x3resize(ORIG_LINEARIZED, tex_uv_g, blur_dxdy, bloom_approx_sigma);
            color_b = fragment_tex2Dblur3x3resize(ORIG_LINEARIZED, tex_uv_b, blur_dxdy, bloom_approx_sigma);
        } else {
            color = fragment_tex2Dblur3x3resize(ORIG_LINEARIZED, tex_uv, blur_dxdy);
        }
    } else {
        if (fragment_beam_misconvergence) {
            color_r = fragment_tex2D_linearize(ORIG_LINEARIZED, tex_uv_r).rgb;
            color_g = fragment_tex2D_linearize(ORIG_LINEARIZED, tex_uv_g).rgb;
            color_b = fragment_tex2D_linearize(ORIG_LINEARIZED, tex_uv_b).rgb;
        } else {
            color = fragment_tex2D_linearize(ORIG_LINEARIZED, tex_uv).rgb;
        }
    }
    if (fragment_beam_misconvergence) {
        color = vec3(color_r.r, color_g.g, color_b.b);
    }
    FragColor = fragment_encode_output(vec4(fragment_tex2D_linearize(ORIG_LINEARIZED, tex_uv)));
}

vec4 hook() {
    vertex_main();
    fragment_main();
    return FragColor;
}


//!HOOK MAIN
//!COMPONENTS 4
//!DESC blur9fast-vertical.slang
//!WIDTH BLOOM_APPROX.width 1 *
//!HEIGHT BLOOM_APPROX.height 1 *
//!SAVE _PASS_3
//!BIND HOOKED
//!BIND BLOOM_APPROX
//!BIND MAIN_RGB

vec4 vertex_gl_Position;
struct _params_ {
    vec4 SourceSize;
    vec4 OriginalSize;
    vec4 OutputSize;
    uint FrameCount;
} params = _params_(vec4(BLOOM_APPROX_size, BLOOM_APPROX_pt), vec4(MAIN_RGB_size, MAIN_RGB_pt), vec4(target_size, 1. / target_size.x, 1. / target_size.y), uint(frame));
struct _global_ {
    mat4 MVP;
} global = _global_(mat4(1.));
vec4 Position = vec4(HOOKED_pos, 0., 1.);
vec2 TexCoord = HOOKED_pos;
